# MoneyApp configuration. Copy to /config/config.yaml and edit.
#
# This file is authoritative; every key can be overridden by an environment
# variable named MONEYAPP_<SECTION>_<KEY>, e.g. MONEYAPP_SERVER_ADDR.
#
# Secrets come from the environment only and have no key here
# (docs/10-deployment-ci.md §10.3). The process refuses to start on an unusable
# configuration rather than failing hours later, naming every offending key.

server:
  addr: ":8080"
  # Absolute, including scheme: used for absolute links and to decide whether the
  # session cookie is marked Secure.
  base_url: "https://money.example.com"

database:
  path: "/config/moneyapp.db"
  # SQLite serialises writes; a large pool only adds contention.
  max_open_conns: 4
  max_idle_conns: 2
  busy_timeout_ms: 5000

auth:
  session_ttl: "720h"
  bcrypt_cost: 12
  # First run only. The admin is created with this email and the password from
  # MONEYAPP_BOOTSTRAP_PASSWORD, and must change it at first login. There is no
  # registration endpoint (docs/adr/0010-invite-only-auth.md).
  bootstrap_admin_email: "admin@example.com"
  # Per-IP login backoff. Per-account lockout is deliberately absent: it is a
  # denial-of-service lever against a known address.
  login_rate_limit: 5
  login_rate_window: "15m"

telegram:
  # Opt-in, long-polling only, off by default.
  enabled: false
  token: "" # MONEYAPP_TELEGRAM_TOKEN
  max_file_bytes: 20971520

imports:
  # Raw uploads are retained here so a batch can be reprocessed after an importer
  # fix without re-exporting from the phone. Files are plaintext.
  upload_dir: "/config/uploads"
  max_upload_bytes: 8388608

providers:
  fx:
    primary: open-er-api
    fallback: fawazahmed0
    refresh: "24h"
    # Reject a single-day move larger than this and flag it: a silently wrong rate
    # would corrupt every derived figure while looking like a real event.
    plausibility_max_change: 0.15

backup:
  enabled: true
  # Only `M H * * *` is honoured; anything else falls back to a daily interval
  # rather than pretending to be a cron implementation.
  schedule: "0 3 * * *"
  keep: 14
  # Defaults to a `backups` directory beside the database, which is the mounted
  # volume in every deployment.
  path: "/config/backups"

log:
  level: info
  format: json
  # Redacts passwords, tokens, api keys and Telegram bot tokens embedded in URLs.
  mask_pii: true

reports:
  base_currency: EUR
  # The workbook's C2 "Percent for yellow": 90-100% of plan shows amber.
  warn_percent: 10
  # Was hardcoded 2x in the workbook.
  over_multiplier: 2
