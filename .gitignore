# Build output
/moneyfly
web-ui/dist/
node_modules/

# The built SPA is copied over backend/internal/web/dist before a release build.
# Only the placeholder index.html is tracked, so the package compiles in a fresh
# checkout without a frontend build.
backend/internal/web/dist/*
!backend/internal/web/dist/index.html

# Runtime data — never commit someone's ledger
/config/*
!/config/config.example.yaml

# Tooling
.eslintcache
.vite/
*.local
.DS_Store
