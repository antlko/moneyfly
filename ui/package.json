{
  "name": "moneyapp-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.8.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  }
}
